@startuml DiagramaSecuencia_CU07_EliminarUsuario

title CU-07 — Eliminar usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmAdminUsuarios" as F #FEFECE
participant ":UsuarioBLL" as B #E8F4E8
participant ":PerfilBLL" as PB #E8F4E8
participant ":UsuarioHistorialBLL" as HB #E8F4E8
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : seleccionar usuario + click "Eliminar"
SYS -> F : seleccionar usuario + click "Eliminar"
alt 1a. sin selección
  F --> SYS : "Seleccioná un usuario."
  SYS --> A : "Seleccioná un usuario."
else 2a. es el usuario de la sesión
  F --> SYS : "No podés eliminar tu propio usuario."
  SYS --> A : "No podés eliminar tu propio usuario."
else
  F --> SYS : "¿Eliminar al usuario 'X'?\nEsta acción no se puede deshacer."
  SYS --> A : "¿Eliminar al usuario 'X'?\nEsta acción no se puede deshacer."
  alt 4a. cancela
    A --> SYS : No
    SYS --> F : No
  else confirma
    A --> SYS : Sí
    SYS --> F : Sí
    F -> B : Eliminar(id)
    B -> PB : ValidarQueQuedeAdministracion(usuarioId, [])
    PB -> DB : USUARIO_PERFIL_LISTAR_ACTIVOS\n+ ROL_PERMISO_LISTAR_TODOS
    alt 5a. quedaría sin administración
      PB --> F : InvalidOperationException
      F --> SYS : "No se puede guardar: el sistema quedaría\nsin ningún usuario activo con el permiso '...'."
      SYS --> A : "No se puede guardar: el sistema quedaría\nsin ningún usuario activo con el permiso '...'."
    else permitido
      B -> HB : RegistrarCambio(id, "BAJA", admin)
      note right of HB : la BAJA se registra antes de borrar\npara guardar el último estado
      B -> DB : USUARIO_ELIMINAR
      B -> I : RecalcularIntegridadUsuarios()
      F -> B : ListarPaginado(...)
      F --> SYS : grilla refrescada
      SYS --> A : grilla refrescada
    end
  end
end

@enduml
