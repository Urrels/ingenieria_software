@startuml DiagramaSecuencia_CU04_CambiarContrasena

title CU-04 — Cambiar contraseña — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Usuario" as U
participant ":frmContraseña" as F #FEFECE
participant ":ValidadorContrasena" as V #F4E8E8
participant ":UsuarioBLL" as B #E8F4E8
participant ":Hasher" as H #F4E8E8
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

U -> F : contraseña actual, nueva y confirmación\n+ click "Continuar"
alt 2a. algún campo vacío
  F --> U : "Completá todos los campos."
else 3a. nueva ≠ confirmación
  F --> U : "Las contraseñas no coinciden."
else campos válidos
  F -> V : ObtenerError(nueva)
  V --> F : null o regla incumplida
  alt 4a. no cumple las reglas
    F --> U : regla incumplida (6 caracteres,\nuna mayúscula, un número)
  else cumple
    F -> B : VerificarContrasena(usuario, actual)
    B -> H : Hashear(actual)
    B -> DB : USUARIO_LOGIN(usuario, hash)
    alt 5a. contraseña actual incorrecta
      F --> U : "La contraseña actual es incorrecta."
    else correcta
      F -> B : CambiarContrasena(usuario, nueva)
      B -> H : Hashear(nueva)
      B -> DB : USUARIO_CAMBIAR_PASS
      B -> DB : BITACORA: CAMBIO_CONTRASENA
      B -> I : RecalcularIntegridadUsuarios()
      B -> DB : HISTORIAL: CAMBIO_CLAVE
      B --> F : true
      F --> U : "Contraseña cambiada exitosamente."
    end
  end
end

@enduml
