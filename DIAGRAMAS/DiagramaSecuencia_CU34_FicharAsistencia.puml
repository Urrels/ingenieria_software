@startuml DiagramaSecuencia_CU34_FicharAsistencia

title CU-34 — Fichar asistencia — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Empleado" as E
boundary ":Sistema" as SYS #FFFFFF
participant ":frmFicharAsistencia" as F #FEFECE
participant ":AsistenciaPersonalBLL" as AB #E8F4E8
database ":DB" as DB #E8E8F4

E -> SYS : abrir "Fichar asistencia"
SYS -> F : abrir "Fichar asistencia"
F -> AB : ObtenerEstado(usuario)
AB -> DB : ASISTENCIA_OBTENER_ABIERTA(hoy)
DB --> AB : filas
AB --> F : resultado
F --> SYS : estado del día (habilita Ingreso o Egreso)
SYS --> E : estado del día (habilita Ingreso o Egreso)
alt "Ingreso"
  E -> SYS : click "Ingreso"
  SYS -> F : click "Ingreso"
  F -> AB : RegistrarIngreso(usuario)
  AB -> DB : ASISTENCIA_OBTENER_ABIERTA(hoy)
  alt 3a. ya tiene un ingreso abierto
    DB --> AB : filas
    AB --> F : OK
    F --> SYS : "Ya tenés un ingreso registrado hoy sin egreso."
    SYS --> E : "Ya tenés un ingreso registrado hoy sin egreso."
  else
    DB --> AB : filas
    AB -> DB : ASISTENCIA_REGISTRAR_INGRESO(hoy, hora actual)
    DB --> AB : OK
    AB --> F : OK
    F --> SYS : "Ingreso registrado a las HH:mm."
    SYS --> E : "Ingreso registrado a las HH:mm."
  end
else "Egreso"
  E -> SYS : click "Egreso"
  SYS -> F : click "Egreso"
  F -> AB : RegistrarEgreso(usuario)
  AB -> DB : ASISTENCIA_OBTENER_ABIERTA(último ingreso sin egreso, de cualquier fecha)
  alt 5a. no tiene ingreso abierto
    DB --> AB : filas
    AB --> F : OK
    F --> SYS : "No tenés un ingreso registrado hoy..."
    SYS --> E : "No tenés un ingreso registrado hoy..."
  else
    DB --> AB : filas
    AB -> DB : ASISTENCIA_REGISTRAR_EGRESO(hora actual)
    DB --> AB : OK
    AB --> F : OK
    F --> SYS : "Egreso registrado a las HH:mm."
    SYS --> E : "Egreso registrado a las HH:mm."
  end
end

@enduml
