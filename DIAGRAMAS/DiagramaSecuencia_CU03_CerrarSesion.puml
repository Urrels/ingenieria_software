@startuml DiagramaSecuencia_CU03_CerrarSesion

title CU-03 — Cerrar sesión — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Usuario" as U
participant ":frmMenu" as M #FEFECE
participant ":BitacoraBLL" as B #E8F4E8
participant ":SessionManager" as S #F4E8E8
participant ":LogIn" as L #FEFECE
database ":DB" as DB #E8E8F4

U -> M : click "Cerrar sesión"
M -> S : getUsuario().Usuario
S --> M : nombre de usuario
M -> B : RegistrarLogout(usuario)
B -> DB : BITACORA_INSERTAR(usuario, "LOGOUT")
M -> S : cerrarSesion()
note right of S : _instance = null:\nla próxima sesión arranca limpia
M -> L : new LogIn().Show()
M -> M : Close()
L --> U : pantalla de inicio de sesión

@enduml
