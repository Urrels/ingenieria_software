@startuml DiagramaSecuencia_CU27_RegistrarUsoEquipo

title CU-27 — Registrar uso de equipamiento — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Empleado" as E
actor ":Sensor IoT" as SI
boundary ":Sistema" as SYS #FFFFFF
participant ":frmRegistrarUsoMaquina" as F #FEFECE
participant ":ApiSensoresEquipos" as API #FEFECE
participant ":EquipoBLL" as EB #E8F4E8
participant ":AlertaRevisionBLL" as AB #E8F4E8
database ":DB" as DB #E8E8F4

alt carga manual
  E -> SYS : abrir "Registrar uso"
  SYS -> F : abrir "Registrar uso"
  F -> EB : ListarTodos()
  EB -> DB : EQUIPO_LISTAR_TODOS
  F -> F : mostrar solo equipos "Operativo"
  E -> SYS : elegir equipo + "Registrar"
  SYS -> F : elegir equipo + "Registrar"
  F -> EB : RegistrarUso(equipoId, 1)
else 1a. sensor IoT
  SI -> SYS : POST /api/equipos/uso\n{NombreEquipo, Incremento}
  SYS -> API : POST /api/equipos/uso\n{NombreEquipo, Incremento}
  API -> EB : ObtenerPorNombre(nombre)
  EB -> DB : EQUIPO_OBTENER_POR_NOMBRE
  alt equipo inexistente
    API --> SYS : 400 {ok: false}
    SYS --> SI : 400 {ok: false}
  else
    API -> EB : RegistrarUso(equipoId, incremento)
  end
end
EB -> DB : EQUIPO_ACTUALIZAR_USO
DB --> EB : uso acumulado, nivel crítico
EB -> DB : EQUIPO_USO_LOG_INSERTAR
alt 4a. sin nivel crítico configurado
  EB -> DB : NOTIFICACION_EXISTE_HOY\n+ NOTIFICACION_INSERTAR a cada admin\n(NotificacionBLL, una vez por día)
  EB --> F : false
  F --> SYS : "El equipo no tiene un nivel de uso crítico configurado..."
  SYS --> E : "El equipo no tiene un nivel de uso crítico configurado..."
else con nivel crítico
  opt uso acumulado >= nivel crítico
    EB -> AB : GenerarAlerta(equipoId)
    AB -> DB : ALERTA_INSERTAR
    note right of DB : si el equipo ya tiene una alerta\nabierta devuelve esa; si no,\ncrea una "Pendiente"
  end
  EB --> F : true
  F --> SYS : "Registro de uso guardado correctamente."
  SYS --> E : "Registro de uso guardado correctamente."
  API --> SYS : 200 {ok: true}
  SYS --> SI : 200 {ok: true}
end

@enduml
