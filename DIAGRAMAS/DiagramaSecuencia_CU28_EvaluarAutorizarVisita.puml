@startuml DiagramaSecuencia_CU28_EvaluarAutorizarVisita

title CU-28 — Evaluar y autorizar visita técnica — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmMantenimientoPredictivo" as MP #FEFECE
participant ":frmEvaluarAutorizarVisita" as F #FEFECE
participant ":EquipoBLL" as EB #E8F4E8
participant ":AlertaRevisionBLL" as AB #E8F4E8
database ":DB" as DB #E8E8F4

opt 1a. consultar el panel predictivo
  A -> MP : abrir "Mantenimiento predictivo"
  MP -> EB : ListarTodos()
  loop por cada equipo con nivel crítico
    MP -> EB : EstimarDiasHastaCritico(equipo, 14)
    EB -> DB : EQUIPO_USO_LOG_ULTIMOS_DIAS
    EB -> EB : (nivel crítico − uso acumulado)\n/ uso diario promedio
  end
  MP --> A : equipos por días estimados\n(Alta ≤ 3, Media ≤ 10, Baja)
end

A -> F : abrir "Evaluar y autorizar"
F -> AB : ListarPendientes()
AB -> DB : ALERTA_LISTAR_PENDIENTES
F --> A : alertas pendientes
A -> F : seleccionar alerta
alt "Autorizar"
  A -> F : click "Autorizar"
  F -> AB : ObtenerEquipoDeAlerta(alerta)
  F --> A : "¿Autorizar la visita técnica para 'X'?"
  A -> F : Sí
  F -> AB : AutorizarVisita(alerta)
  AB -> DB : ALERTA_ACTUALIZAR_ESTADO ("Autorizada")
  F --> A : "Visita autorizada."
else 2a. "Descartar"
  A -> F : click "Descartar"
  F --> A : "¿Descartar esta alerta como falso positivo?"
  A -> F : Sí
  F -> AB : DescartarAlerta(alerta)
  AB -> DB : ALERTA_ACTUALIZAR_ESTADO ("Descartada")
  F --> A : "Alerta descartada."
end
F -> AB : ListarPendientes()

@enduml
