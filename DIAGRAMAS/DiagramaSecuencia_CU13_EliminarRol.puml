@startuml DiagramaSecuencia_CU13_EliminarRol

title CU-13 — Eliminar rol — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmPerfiles" as F #FEFECE
participant ":PerfilBLL" as PB #E8F4E8
participant ":BitacoraBLL" as BB #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : seleccionar nodo
SYS -> F : seleccionar nodo
F -> F : btnEliminar.Enabled = no protegido
A -> SYS : click "Eliminar"
SYS -> F : click "Eliminar"
alt 1a. el nodo es un permiso
  F --> SYS : "Los permisos del catálogo no se pueden eliminar..."
  SYS --> A : "Los permisos del catálogo no se pueden eliminar..."
else es un rol
  F --> SYS : "¿Eliminar el rol 'X' y todos sus sub-roles?"
  SYS --> A : "¿Eliminar el rol 'X' y todos sus sub-roles?"
  alt 3a. cancela
    A --> SYS : No
    SYS --> F : No
  else confirma
    A --> SYS : Sí
    SYS --> F : Sí
    F -> PB : Eliminar(id)
    PB -> DB : ROL_LISTAR_TODOS
    alt 1b. rol protegido
      PB --> F : InvalidOperationException
      F --> SYS : "Este rol es del sistema y no puede eliminarse."
      SYS --> A : "Este rol es del sistema y no puede eliminarse."
    else
      PB -> DB : ROL_TIENE_USUARIOS(id)\n(CTE recursiva sobre el subárbol)
      alt 4a. hay usuarios asignados
        PB --> F : InvalidOperationException
        F --> SYS : "No se puede eliminar un rol que tiene\nusuarios asignados. Reasignálos primero."
        SYS --> A : "No se puede eliminar un rol que tiene\nusuarios asignados. Reasignálos primero."
      else sin usuarios
        PB -> DB : ROL_ELIMINAR(id)
        note right of DB : borra el subárbol y sus filas\nde USUARIO_PERFIL y ROL_PERMISO
        PB -> BB : RegistrarAccion(admin, "ROL_ELIMINADO:X")
        F -> F : ocultar panel de permisos
        F -> PB : ObtenerArbol()
        F --> SYS : árbol refrescado
        SYS --> A : árbol refrescado
      end
    end
  end
end

@enduml
