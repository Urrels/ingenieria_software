@startuml DiagramaSecuencia_CU29_CoordinarVisita

title CU-29 — Coordinar visita técnica — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmCoordinarVisita" as F #FEFECE
participant ":frmSeleccionarReemplazo" as SR #FEFECE
participant ":AlertaRevisionBLL" as AB #E8F4E8
participant ":VisitaTecnicaBLL" as VB #E8F4E8
participant ":EquipoBLL" as EB #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : abrir "Coordinar visita"
SYS -> F : abrir "Coordinar visita"
F -> F : fecha propuesta = mañana
F -> AB : ListarAutorizadas()
AB -> DB : ALERTA_LISTAR_AUTORIZADAS
DB --> AB : filas
AB --> F : resultado
F --> SYS : alertas autorizadas
SYS --> A : alertas autorizadas
A -> SYS : seleccionar alerta
SYS -> F : seleccionar alerta
F -> EB : ObtenerPorId(equipoId)
EB --> F : resultado
F -> VB : ObtenerTecnicoHabitual(equipo)
VB -> DB : USUARIO_OBTENER_POR_ID
DB --> VB : filas
VB --> F : resultado
F --> SYS : "Técnico habitual: X"\n(o "Sin técnico habitual asignado")
SYS --> A : "Técnico habitual: X"\n(o "Sin técnico habitual asignado")
opt 2a. buscar técnico alternativo
  A -> SYS : click "Buscar alternativo"
  SYS -> F : click "Buscar alternativo"
  F -> VB : ListarTecnicosAlternativos()
  VB -> DB : VISITA_TECNICOS_ALTERNATIVOS
  alt no hay alternativos
    DB --> VB : resultado
    VB --> F : resultado
    F --> SYS : "No hay técnicos alternativos registrados..."
    SYS --> A : "No hay técnicos alternativos registrados..."
  else
    DB --> VB : resultado
    VB --> F : resultado
    F -> SR : ShowDialog(alternativos)
    SR --> F : OK
    F --> SYS : OK
    SYS --> A : OK
    A -> SYS : elegir técnico
    SYS -> SR : elegir técnico
    SR --> SYS : OK
    SYS --> A : OK
  end
end
A -> SYS : ajustar fecha + "Confirmar"
SYS -> F : ajustar fecha + "Confirmar"
alt 3a. sin técnico elegido
  F --> SYS : "Elegí un técnico (habitual o alternativo)..."
  SYS --> A : "Elegí un técnico (habitual o alternativo)..."
else
  F -> VB : CoordinarVisita(alertaId, tecnicoId, fecha)
  VB -> DB : VISITA_INSERTAR (estado "Coordinada")
  DB --> VB : OK
  VB --> F : OK
  F -> AB : MarcarCoordinada(alerta)
  AB -> DB : ALERTA_ACTUALIZAR_ESTADO ("Coordinada")
  DB --> AB : OK
  AB --> F : OK
  F --> SYS : "Solicitud de visita confirmada."
  SYS --> A : "Solicitud de visita confirmada."
end

@enduml
