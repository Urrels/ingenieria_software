@startuml DiagramaSecuencia_CU37_GestionarFranjas

title CU-37 — Gestionar franjas horarias — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmGestionFranjas" as F #FEFECE
participant ":FranjaHorariaBLL" as FB #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : abrir "Franjas horarias"
SYS -> F : abrir "Franjas horarias"
F -> FB : ListarTodas()
FB -> DB : FRANJA_HORARIA_LISTAR_TODAS
F --> SYS : franjas cargadas
SYS --> A : franjas cargadas
alt agregar
  A -> SYS : día, rol, hora inicio, hora fin + "Agregar"
  SYS -> F : día, rol, hora inicio, hora fin + "Agregar"
  alt 2a. falta día o rol
    F --> SYS : "Seleccioná día y rol."
    SYS --> A : "Seleccioná día y rol."
  else
    F -> FB : Insertar(día, inicio, fin, rol)
    alt 3a. fin <= inicio
      FB --> F : ArgumentException
      F --> SYS : "La hora de fin tiene que ser posterior..."
      SYS --> A : "La hora de fin tiene que ser posterior..."
    else
      FB -> DB : FRANJA_HORARIA_INSERTAR
      F --> SYS : "Franja agregada."
      SYS --> A : "Franja agregada."
    end
  end
else eliminar
  A -> SYS : seleccionar franja + "Eliminar" + confirmar
  SYS -> F : seleccionar franja + "Eliminar" + confirmar
  F -> FB : Eliminar(id)
  FB -> DB : FRANJA_HORARIA_ELIMINAR
  alt 5a. tiene datos asociados
    F --> SYS : "No se puede eliminar: ya tiene disponibilidad,\nturnos, o historial asociado."
    SYS --> A : "No se puede eliminar: ya tiene disponibilidad,\nturnos, o historial asociado."
  else
    F --> SYS : "Franja eliminada."
    SYS --> A : "Franja eliminada."
  end
end
F -> FB : ListarTodas()

@enduml
