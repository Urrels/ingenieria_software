@startuml DiagramaSecuencia_CU10_VerHistorial

title CU-10 — Ver historial de usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmAdminUsuarios" as F #FEFECE
participant ":frmHistorialUsuario" as H #FEFECE
participant ":UsuarioHistorialBLL" as HB #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : seleccionar usuario + click "Historial"
alt 1a. sin selección
  F --> A : "Seleccioná un usuario."
else
  F -> H : new(usuario).ShowDialog()
  H -> HB : ObtenerHistorialPaginado(id, página 1, 20)
  HB -> DB : USUARIO_HISTORIAL_LISTAR_PAGINADO
  DB --> HB : entradas + total
  HB --> H : PaginaResultado
  H -> H : mostrar grilla, "Página 1 de N"\nbtnRollback deshabilitado
  alt 2a. sin historial
    H --> A : grilla vacía
  else con historial
    H --> A : fecha, tipo, rol, bloqueado, intentos,\nperfiles, datos personales, realizado por,\nversión origen
  end
  opt 3a. navegar páginas
    A -> H : "Anterior" / "Siguiente"
    H -> HB : ObtenerHistorialPaginado(id, página, 20)
  end
  opt seleccionar una entrada
    A -> H : seleccionar fila
    H -> H : btnRollback.Enabled = tipo ≠ BAJA
    note right of H : continúa en CU-11
  end
  A -> H : "Cerrar"
  F -> F : refrescar grilla de usuarios
end

@enduml
