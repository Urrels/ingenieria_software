@startuml DiagramaSecuencia_CU38_LiquidarHoras

title CU-38 — Liquidar horas de empleados — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmLiquidarHoras" as F #FEFECE
participant ":LiquidacionBLL" as L #E8F4E8
participant ":PresenciaBLL" as P #E8F4E8
participant ":LiquidacionCalculo" as C #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : abrir "Liquidar horas" (permiso "Liquidar horas")
SYS -> F : abrir "Liquidar horas" (permiso "Liquidar horas")
F --> SYS : OK
SYS --> A : OK
A -> SYS : elegir período (desde / hasta) y click "Calcular"
SYS -> F : elegir período (desde / hasta) y click "Calcular"
F -> L : Calcular(desde, hasta)
L -> P : ObtenerFichajes(desde, hasta)
P -> DB : ASISTENCIA_LISTAR_RANGO
DB --> P : filas
P --> L : resultado
L -> DB : TURNO_LISTAR_ASIGNADOS_RANGO + VALOR_HORA_LISTAR + FERIADO_LISTAR + EXCEDENTE_LISTAR + PARAMETRO_LIQUIDACION_LISTAR
DB --> L : filas
L -> C : Calcular(entrada)
note right of C
  Por empleado y día:
  1. horas fichadas (turnos que cruzan la medianoche incluidos)
  2. tolerancia contra lo asignado y redondeo
  3. horas a pagar = mín(fichadas, asignadas) + excedente aprobado
  4. normales / extra (recargo) / domingo-feriado (recargo)
  5. importe con el valor hora vigente ese día
  Ausente = turno terminado sin fichajes
end note
C --> L : filas por empleado y día
L --> F : resultado
F --> SYS : resumen por empleado + detalle del día + avisos\n(fichajes incompletos, sin valor hora, excedentes a aprobar)
SYS --> A : resumen por empleado + detalle del día + avisos\n(fichajes incompletos, sin valor hora, excedentes a aprobar)

opt aprobar excedente
  A -> SYS : seleccionar un día con excedente y "Aprobar excedente"
  SYS -> F : seleccionar un día con excedente y "Aprobar excedente"
  F -> L : AprobarExcedente(empleado, fecha)
  L -> DB : EXCEDENTE_APROBAR + bitácora
  DB --> L : OK
  L --> F : OK
  F --> SYS : OK
  SYS --> A : OK
end

opt exportar o imprimir
  A -> SYS : "Exportar a Excel" / "Imprimir recibo"
  SYS -> F : "Exportar a Excel" / "Imprimir recibo"
  F --> SYS : libro .xlsx (Resumen, Detalle, Criterios) / vista previa del recibo
  SYS --> A : libro .xlsx (Resumen, Detalle, Criterios) / vista previa del recibo
end

opt cerrar el período
  A -> SYS : click "Cerrar período" y confirmar
  SYS -> F : click "Cerrar período" y confirmar
  F -> L : Cerrar(desde, hasta, administrador)
  alt 8a. el período no terminó, se superpone con otra liquidación,\nhay fichajes incompletos o falta el valor hora
    L --> F : InvalidOperationException (mensaje)
    F --> SYS : motivo por el que no se puede cerrar
    SYS --> A : motivo por el que no se puede cerrar
  else
    L -> DB : LIQUIDACION_INSERTAR + LIQUIDACION_DIA_INSERTAR x N (una transacción) + bitácora
    DB --> L : OK
    L --> F : OK
    F --> SYS : período cerrado (los números ya no se recalculan)
    SYS --> A : período cerrado (los números ya no se recalculan)
  end
end

opt marcar como pagada
  A -> SYS : seleccionar una liquidación cerrada y "Marcar como pagada"
  SYS -> F : seleccionar una liquidación cerrada y "Marcar como pagada"
  F -> L : MarcarPagada(liquidacion)
  L -> DB : LIQUIDACION_MARCAR_PAGADA + bitácora
  DB --> L : OK
  L --> F : OK
  F --> SYS : OK
  SYS --> A : OK
end

@enduml
