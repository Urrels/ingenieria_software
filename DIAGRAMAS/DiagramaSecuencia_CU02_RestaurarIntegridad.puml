@startuml DiagramaSecuencia_CU02_RestaurarIntegridad

title CU-02 — Restaurar integridad del sistema — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":LogIn" as LI #FEFECE
participant ":frmRestaurarIntegridad" as F #FEFECE
participant ":frmHistorialUsuario" as FH #FEFECE
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

LI -> F : ShowDialog(resultado)
F -> F : mostrar errores
F -> F : GuardarLogIntegridad()\n→ integridad_error.log
F -> F : "Restaurar" habilitado si\nhay usuarios afectados
alt "Recalcular y continuar"
  F --> LI : OK
  A -> SYS : click
  SYS -> F : click
  F -> I : RecalcularIntegridadUsuarios()
  I -> DB : DVH por fila + DVV por columna
  F --> LI : OK
  DB --> I : resultado
  I --> F : OK
  F --> SYS : OK
  SYS --> A : OK
else 4a. "Restaurar desde historial"
  F --> LI : OK
  A -> SYS : click
  SYS -> F : click
  loop por cada usuario afectado
    F -> DB : historial del usuario\n(UsuarioHistorialBLL)
    alt 4a.1 sin historial
      DB --> F : OK
      F --> SYS : "El usuario 'X' no tiene\nhistorial de cambios..."
      SYS --> A : "El usuario 'X' no tiene\nhistorial de cambios..."
    else con historial
      DB --> F : OK
      F -> FH : ShowDialog()
      FH --> F : OK
      F --> SYS : OK
      SYS --> A : OK
      A -> SYS : CU-10 / CU-11 rollback
      SYS -> FH : CU-10 / CU-11 rollback
      FH --> SYS : OK
      SYS --> A : OK
    end
  end
  opt alguno tenía historial
    F -> I : RecalcularIntegridadUsuarios()
    F --> LI : OK
    I --> F : OK
  end
    F --> SYS : OK
    SYS --> A : OK
else 4b. "Cancelar"
  F --> LI : OK
  A -> SYS : click
  SYS -> F : click
  F --> LI : Cancel
  LI -> LI : cerrarSesion()
  F --> SYS : OK
  SYS --> A : OK
end
LI --> SYS : con OK: abre el menú (CU-01)
SYS --> A : con OK: abre el menú (CU-01)

@enduml
