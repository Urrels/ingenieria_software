@startuml DiagramaSecuencia_CU05_CambiarIdioma

title CU-05 — Cambiar idioma — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Usuario" as U
participant ":Formulario" as F #FEFECE
participant ":FachadaIdioma" as FA #E8F4E8
participant ":IdiomaManager" as IM #F4E8E8
participant ":Pantallas abiertas" as O #FEFECE
database ":DB" as DB #E8E8F4

U -> F : elegir idioma\nen el selector
F -> FA : Cambiar(idioma)
FA -> DB : TRADUCCION_LISTAR_CONTROLES\n(IdiomaBLL)
DB --> FA : clave → texto
FA -> IM : CambiarIdioma(idioma,\ntraducciones)
IM -> IM : Notificar()
loop por cada observador
  IM -> O : ActualizarIdioma()
  O -> IM : Traducir(clave)
  O -> O : traducción o texto\npor defecto
end
alt hay sesión iniciada
  FA -> DB : USUARIO_ACTUALIZAR_IDIOMA\n(UsuarioBLL)
else 5a. sin sesión
  note right of FA : no se guarda\nla preferencia
end
F --> U : pantallas traducidas

@enduml
