@startuml DiagramaSecuencia_CU15_AsignarPermisosRol

title CU-15 — Asignar permisos a rol — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmPerfiles" as F #FEFECE
participant ":PerfilBLL" as PB #E8F4E8
participant ":BitacoraBLL" as BB #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : seleccionar un rol
SYS -> F : seleccionar un rol
alt 1a. el nodo es un permiso
  F -> F : panelPermisos.Visible = false
  F --> SYS : OK
  SYS --> A : OK
else es un rol
  F -> F : PopularCheckPermisos(rol)
  note right of F : marca los permisos propios del rol\n(ROL_PERMISO), sin heredar del padre
  F --> SYS : OK
  SYS --> A : OK
  A -> SYS : marcar / desmarcar + "Guardar"
  SYS -> F : marcar / desmarcar + "Guardar"
  F -> PB : ActualizarPermisosDeRol(rolId, permisoIds)
  PB -> PB : ValidarQueQuedeAdministracion(rolId, permisoIds)
  PB -> DB : USUARIO_PERFIL_LISTAR_ACTIVOS\n+ ROL_PERMISO_LISTAR_TODOS
  alt 4a. quedaría sin administración
    DB --> PB : filas
    PB --> F : InvalidOperationException
    F --> SYS : mensaje con el permiso que se perdería
    SYS --> A : mensaje con el permiso que se perdería
  else permitido
    DB --> PB : filas
    PB -> DB : GuardarPermisosDeRol (transacción:\nLIMPIAR + N × INSERTAR)
    DB --> PB : resultado
    PB -> BB : RegistrarAccion(admin, "ROL_PERMISOS_MODIFICADOS:X")
    BB --> PB : OK
    PB --> F : OK
    F -> PB : ObtenerArbol()
    PB --> F : resultado
    F -> F : volver a seleccionar el rol
    F --> SYS : árbol con los permisos actualizados
    SYS --> A : árbol con los permisos actualizados
  end
end

@enduml
