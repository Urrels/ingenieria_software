@startuml DiagramaSecuencia_CU18_EliminarIdioma

title CU-18 — Eliminar idioma — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmIdiomas" as F #FEFECE
participant ":IdiomaBLL" as IB #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : seleccionar idioma + click "Eliminar"
alt 1a. sin selección
  F --> A : "Seleccioná un idioma."
else 2a. es el predeterminado
  F --> A : "No se puede eliminar el idioma predeterminado del sistema."
else
  F -> IB : EstaEnUso(id)
  IB -> DB : IDIOMA_ESTA_EN_USO
  alt 3a. lo usa algún usuario
    F --> A : "No se puede eliminar un idioma que está\nen uso por algún usuario."
  else libre
    F --> A : "¿Eliminar el idioma 'X'?\nSe borrarán todas sus traducciones."
    alt 4a. cancela
      A --> F : No
    else confirma
      A --> F : Sí
      F -> IB : Eliminar(id)
      IB -> IB : backstop: predeterminado / en uso
      IB -> DB : IDIOMA_ELIMINAR(id)
      note right of DB
        transacción: vuelve a controlar
        las dos reglas (THROW 50001/50002)
        y borra TRADUCCION + IDIOMA
      end note
      F -> F : limpiar grilla de traducciones
      F -> IB : ListarTodos()
      F --> A : grilla de idiomas refrescada
    end
  end
end

@enduml
