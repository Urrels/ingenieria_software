@startuml DiagramaSecuencia_CU12_CrearRol

title CU-12 — Crear rol — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmPerfiles" as F #FEFECE
participant ":PerfilBLL" as PB #E8F4E8
participant ":BitacoraBLL" as BB #E8F4E8
database ":DB" as DB #E8E8F4

opt elegir padre
  A -> F : seleccionar un rol en el árbol
end
A -> F : click "Agregar rol"
F --> A : InputBox "Nombre del rol:"
A -> F : nombre + Aceptar
alt 3a. nombre vacío o cancela
  note right of F : no se crea el rol
else
  F -> F : padreId = rol seleccionado\n(null si no hay o es un permiso)
  F -> PB : AgregarRol(nombre, padreId)
  PB -> DB : ROL_INSERTAR(nombre, padre_id)
  DB --> PB : nuevo ID (PROTEGIDO = 0)
  PB -> BB : RegistrarAccion(admin, "ROL_CREADO:nombre")
  BB -> DB : BITACORA_INSERTAR
  F -> PB : ObtenerArbol()
  PB -> DB : ROL_LISTAR_TODOS + ROL_PERMISO_LISTAR_TODOS
  F --> A : árbol refrescado con el nuevo rol
end

@enduml
