@startuml DiagramaSecuencia_CU22_RegistrarDisponibilidad

title CU-22 — Alta de disponibilidad horaria — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Empleado" as E
boundary ":Sistema" as SYS #FFFFFF
participant ":frmRegistrarDisponibilidad" as F #FEFECE
participant ":FranjaHorariaBLL" as FB #E8F4E8
participant ":DisponibilidadBLL" as D #E8F4E8
participant ":SessionManager" as S #F4E8E8
database ":DB" as DB #E8E8F4

E -> SYS : abrir "Disponibilidad"
SYS -> F : abrir "Disponibilidad"
F -> F : semana = lunes de la semana siguiente
F -> S : getUsuario()
S --> F : OK
F -> FB : ListarTodas()
FB -> DB : FRANJA_HORARIA_LISTAR_TODAS
DB --> FB : filas
FB --> F : resultado
F -> F : filtrar franjas del rol del empleado
F -> D : ObtenerPrevia(usuario, semana)
D -> DB : DISPONIBILIDAD_OBTENER_POR_USUARIO_SEMANA
DB --> D : filas
D --> F : resultado
F --> SYS : franjas con día y fecha (sin marcar)
SYS --> E : franjas con día y fecha (sin marcar)
E -> SYS : marcar franjas + "Aceptar"
SYS -> F : marcar franjas + "Aceptar"
alt 5a. ninguna franja marcada
  F --> SYS : "Tenés que indicar al menos una franja."
  SYS --> E : "Tenés que indicar al menos una franja."
else
  F -> D : RegistrarDisponibilidad(usuario, semana, franjas)
  D -> DB : DISPONIBILIDAD_INSERTAR\n+ N × DISPONIBILIDAD_FRANJA_INSERTAR
  DB --> D : OK
  D --> F : OK
  F --> SYS : "Disponibilidad registrada correctamente."
  SYS --> E : "Disponibilidad registrada correctamente."
end

@enduml
