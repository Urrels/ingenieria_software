@startuml DiagramaComponentes - TP_IS

skinparam shadowing false
skinparam roundcorner 6
skinparam componentStyle uml2
skinparam component {
  BackgroundColor #FFCCCC-FFFFFF
  BorderColor #000000
  FontStyle bold
  FontSize 13
}
skinparam ArrowColor #000000
skinparam defaultTextAlignment left

left to right direction
scale 0.8

frame "cmp Arquitectura de Componentes - TP_IS" {

  component "BE (Entidades de Negocio)\n--\n+ AlertaRevision / BITACORA / CONTROL_IDIOMA\n+ ComportamientoDemo / DatosDemo / DatosNegocio\n+ DemandaEstimada / Disponibilidad / EmpleadoDemo\n+ EmpleadoLiquidable / EntradaLiquidacion / Equipo\n+ EquipoDemo / EstadoFichaje / EvaluacionCobertura\n+ EvaluacionFranjaSemana / Feriado / FeriadoDemo\n+ FranjaDemo / FranjaHoraria / GrillaDeTurnos\n+ IDIOMA / InformeCobertura / InformeConclusion\n+ InformeEmpleado / InformeEquipo / InformeGestion\n+ InformeMantenimiento / Liquidacion / LiquidacionDia\n+ LiquidacionResumenEmpleado / LoginResultado / NodoPermiso\n+ Notificacion / PaginaResultado / ParametrosLiquidacion\n+ Permiso / RegistroAsistenciaPersonal / ResultadoCargaDemo\n+ ResultadoFichaje / Rol / SociosEnFecha\n+ Turno / TurnoAsignadoFecha / USUARIO\n+ UsuarioHistorial / ValorHoraEmpleado / VisitaTecnica" as BE

  component "CAPAS (Interfaz de Usuario)\n--\n+ ApiSensoresEquipos / AppTheme / Botones\n+ ConclusionFilaVM / DemoUI / EvaluacionFilaVM\n+ ExcelExportHelper / FeriadoFilaVM / FichajeFilaVM\n+ FormBase / FrmMensaje / Icono\n+ IdiomaUIHelper / InformeCoberturaFilaVM / InformeEmpleadoFilaVM\n+ InformeEquipoFilaVM / InformePdf / ItemRol\n+ LiquidacionDetalleFilaVM / LiquidacionExcel / LiquidacionResumenFilaVM\n+ LogIn / MsgBox / PdfDocumento\n+ PrediccionFilaVM / ReciboHoras / RenderizadorCorporativo\n+ TablaColaresCorpo / Textos / TurnoEmpleadoVM\n+ TurnoFilaVM / TurnoPendienteVM / UsoEquipoRequest\n+ ValorHoraFilaVM / frmAdminUsuarios / frmAjustarPorAusencia\n+ frmAsignarEmpleado / frmAsignarPerfiles / frmBitacora\n+ frmConfirmarCierreMantenimiento / frmContraseña / frmCoordinarVisita\n+ frmCorregirFichajes / frmCubrirTurno / frmDashboard\n+ frmEditarUsuario / frmEvaluarAutorizarVisita / frmEvaluarCobertura\n+ frmFicharAsistencia / frmGenerarGrilla / frmGestionFranjas\n+ frmHistorialUsuario / frmIdiomas / frmInformeGestion\n+ frmLiquidarHoras / frmMantenimientoPredictivo / frmMenu\n+ frmMisNotificaciones / frmMisTurnos / frmNuevoUsuario\n+ frmParametrosLiquidacion / frmPerfiles / frmRealizarRevision\n+ frmRegistrarAsistenciaSocios / frmRegistrarDisponibilidad / frmRegistrarUsoMaquina\n+ frmRestaurarIntegridad / frmSeleccionarReemplazo / frmSimulacionSensores" as CAPAS

  component "BLL (Logica del Negocio)\n--\n+ AlertaRevisionBLL / AsistenciaPersonalBLL / BitacoraBLL\n+ ConexionBLL / DatosDemoBLL / DemandaEstimadaBLL\n+ DisponibilidadBLL / EquipoBLL / EvaluacionCoberturaBLL\n+ EventoFichaje / FachadaIdioma / FranjaHorariaBLL\n+ GrillaBLL / HistorialAsistenciaSociosBLL / IdiomaBLL\n+ InformeGestionBLL / InformeMantenimientoBLL / IntegridadBLL\n+ LiquidacionBLL / LiquidacionCalculo / LoginBLL\n+ NotificacionBLL / PerfilBLL / PlanificadorFichajes\n+ PresenciaBLL / ProbabilidadesFichaje / Reloj\n+ ResultadoEvaluacionFranjaVM / ResultadoIntegridad / TipoFichaje\n+ TurnoBLL / UsuarioBLL / UsuarioHistorialBLL\n+ UsuarioPerfilBLL / VisitaTecnicaBLL" as BLL

  component "SeguridadYServicios\n--\n+ CalculadorDVH / Hasher\n+ IObservadorIdioma / IdiomaManager\n+ SessionManager / ValidadorContrasena" as SyS

  component "DAL (Acceso a Datos)\n--\n+ Acceso\n+ AlertaRevisionDAL / AsistenciaPersonalDAL / BitacoraDAL\n+ ConexionDAL / DemandaEstimadaDAL / DisponibilidadDAL\n+ EquipoDAL / FranjaHorariaDAL / GestionDAL\n+ GrillaDAL / HistorialAsistenciaSociosDAL / IdiomaDAL\n+ InformeMantenimientoDAL / IntegridadDAL / LiquidacionDAL\n+ NotificacionDAL / PerfilDAL / TurnoDAL\n+ UsuarioDAL / UsuarioHistorialDAL / UsuarioPerfilDAL\n+ VisitaTecnicaDAL" as DAL

  component "ConfiguradorBD\n--\n+ ConfiguracionApp / InstaladorBaseDatos\n+ InstanciaSql / LocalDb\n+ Program / RegistroInstalacion\n+ ResultadoVerificacion / frmConfigurador" as CFG

  component "EmuladorFichaje\n--\n+ ApiFichaje / Opciones\n+ Program / Simulador" as EMU

  database "BDCAPAS\n(SQL Server)" as BD

  CAPAS -[dashed]left-> BLL
  BLL -[dashed]left-> SyS
  BLL -[dashed]left-> DAL
  SyS -[hidden]left-> DAL

  CAPAS -[dashed]up-> BE
  BLL -[dashed]up-> BE
  SyS -[dashed]up-> BE
  DAL -[dashed]up-> BE

  DAL -[dashed]down-> BD
  CFG -[dashed]down-> BD
  EMU -[dashed]left-> BLL
}

@enduml
