@startuml DiagramaSecuencia_CU08_DesbloquearUsuario

title CU-08 — Desbloquear usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmAdminUsuarios" as F #FEFECE
participant ":UsuarioBLL" as B #E8F4E8
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : seleccionar usuario\n+ "Desbloquear"
alt 1a. sin selección
  F --> A : "Seleccioná un usuario."
else 2a. no está bloqueado
  F --> A : "El usuario no está bloqueado."
else
  F --> A : "¿Desbloquear al usuario 'X'?"
  alt 3a. cancela
    A --> F : No
  else
    A --> F : Sí
    F -> B : Desbloquear(usuario)
    B -> DB : USUARIO_DESBLOQUEAR\n(bloqueado 0, intentos 0)
    B -> DB : BITACORA:\nDESBLOQUEO_USUARIO:X
    B -> I : RecalcularIntegridadUsuarios()
    B -> DB : HISTORIAL: DESBLOQUEO
    F --> A : "Usuario desbloqueado."
  end
end

@enduml
