@startuml DiagramaSecuencia_CU39_CorregirFichajes

title CU-39 — Corregir fichajes — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmCorregirFichajes" as F #FEFECE
participant ":AsistenciaPersonalBLL" as AB #E8F4E8
participant ":BitacoraBLL" as B #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : abrir "Corregir fichajes" (permiso "Liquidar horas")
F -> AB : Listar(desde, hasta, soloIncompletos)
AB -> DB : ASISTENCIA_LISTAR_RANGO + PARAMETRO_LIQUIDACION_LISTAR
F --> A : fichajes (por defecto, los ingresos sin egreso que superan el máximo de horas)

alt corregir un fichaje existente
  A -> F : seleccionar fichaje, indicar ingreso, egreso y motivo, "Corregir seleccionado"
  F -> AB : Corregir(id, ingreso, egreso, motivo, administrador)
  alt 3a. sin motivo, fecha dentro de un período liquidado\no se superpone con otro fichaje del empleado
    AB --> F : InvalidOperationException (mensaje)
    F --> A : motivo del rechazo
  else
    AB -> DB : ASISTENCIA_CORREGIR (guarda quién, cuándo y los valores anteriores en el motivo)
    AB -> B : RegistrarAccion("FICHAJE_CORREGIDO:" + empleado)
    F --> A : fichaje corregido
  end
else cargar un fichaje que faltaba
  A -> F : elegir empleado y fecha, indicar ingreso, egreso y motivo, "Agregar fichaje manual"
  F -> AB : AgregarManual(empleado, fecha, ingreso, egreso, motivo, administrador)
  AB -> DB : ASISTENCIA_INSERTAR_MANUAL (marcado como corregido)
  AB -> B : RegistrarAccion("FICHAJE_MANUAL:" + empleado)
  F --> A : fichaje agregado
end

@enduml
