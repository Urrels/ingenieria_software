@startuml DiagramaSecuencia_CU17_EditarIdioma

title CU-17 — Editar idioma (renombrar o habilitar/deshabilitar) — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
boundary ":Sistema" as SYS #FFFFFF
participant ":frmIdiomas" as F #FEFECE
participant ":IdiomaBLL" as IB #E8F4E8
database ":DB" as DB #E8E8F4

A -> SYS : seleccionar idioma
SYS -> F : seleccionar idioma
alt 1a. sin selección
  F --> SYS : "Seleccioná un idioma."
  SYS --> A : "Seleccioná un idioma."
else "Renombrar"
  F --> SYS : OK
  SYS --> A : OK
  A -> SYS : click "Renombrar"
  SYS -> F : click "Renombrar"
  F --> SYS : InputBox "Nuevo nombre:"
  SYS --> A : InputBox "Nuevo nombre:"
  A -> SYS : nuevo nombre
  SYS -> F : nuevo nombre
  alt 3a. vacío o igual al actual
    note right of F : no se modifica
  else
    F -> IB : Renombrar(id, nombre)
    IB -> DB : IDIOMA_RENOMBRAR
    DB --> IB : OK
    IB --> F : OK
  end
    F --> SYS : OK
    SYS --> A : OK
else "Habilitar / Deshabilitar"
  F --> SYS : OK
  SYS --> A : OK
  A -> SYS : click "Habilitar/Deshabilitar"
  SYS -> F : click "Habilitar/Deshabilitar"
  F -> IB : ActualizarEstado(id, !habilitado)
  opt deshabilitar
    IB -> DB : IDIOMA_OBTENER_POR_ID + IDIOMA_ESTA_EN_USO
    alt 3b. es el predeterminado
      DB --> IB : filas
      IB --> F : InvalidOperationException
      F --> SYS : "No se puede deshabilitar el idioma predeterminado."
      SYS --> A : "No se puede deshabilitar el idioma predeterminado."
    else 3c. lo usa algún usuario
      DB --> IB : filas
      IB --> F : InvalidOperationException
      F --> SYS : "No se puede deshabilitar un idioma en uso."
      SYS --> A : "No se puede deshabilitar un idioma en uso."
    end
  end
  IB -> DB : IDIOMA_ACTUALIZAR_ESTADO
  DB --> IB : OK
  IB --> F : OK
  F --> SYS : OK
  SYS --> A : OK
end
F -> IB : ListarTodos()
F --> SYS : grilla refrescada
SYS --> A : grilla refrescada

IB --> F : resultado
@enduml
