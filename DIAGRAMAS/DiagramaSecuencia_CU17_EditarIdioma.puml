@startuml DiagramaSecuencia_CU17_EditarIdioma

title CU-17 — Editar idioma (renombrar o habilitar/deshabilitar) — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmIdiomas" as F #FEFECE
participant ":IdiomaBLL" as IB #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : seleccionar idioma
alt 1a. sin selección
  F --> A : "Seleccioná un idioma."
else "Renombrar"
  A -> F : click "Renombrar"
  F --> A : InputBox "Nuevo nombre:"
  A -> F : nuevo nombre
  alt 3a. vacío o igual al actual
    note right of F : no se modifica
  else
    F -> IB : Renombrar(id, nombre)
    IB -> DB : IDIOMA_RENOMBRAR
  end
else "Habilitar / Deshabilitar"
  A -> F : click "Habilitar/Deshabilitar"
  F -> IB : ActualizarEstado(id, !habilitado)
  opt deshabilitar
    IB -> DB : IDIOMA_OBTENER_POR_ID + IDIOMA_ESTA_EN_USO
    alt 3b. es el predeterminado
      IB --> F : InvalidOperationException
      F --> A : "No se puede deshabilitar el idioma predeterminado."
    else 3c. lo usa algún usuario
      IB --> F : InvalidOperationException
      F --> A : "No se puede deshabilitar un idioma en uso."
    end
  end
  IB -> DB : IDIOMA_ACTUALIZAR_ESTADO
end
F -> IB : ListarTodos()
F --> A : grilla refrescada

@enduml
