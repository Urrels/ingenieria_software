@startuml DiagramaSecuencia_CU01_IniciarSesion

title CU-01 — Iniciar sesión — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Usuario" as U
participant ":LogIn" as F #FEFECE
participant ":LoginBLL" as L #E8F4E8
participant ":SessionManager" as S #F4E8E8
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

note over F : Program.cs ya verificó la integridad al arrancar
U -> F : usuario + contraseña\n+ "Ingresar"
alt 2a. campo vacío
  F --> U : "Completá usuario y contraseña."
else
  F -> L : AutenticarUsuario(usuario, contraseña)
  L -> DB : USUARIO_VERIFICAR_BLOQUEO
  alt 3a. bloqueado
    L --> F : UsuarioBloqueado
    F -> I : Recalcular (si integridad válida)
    F --> U : "Usuario bloqueado..."
  else
    L -> L : Hasher.Hashear()\n(SHA-256)
    L -> DB : USUARIO_LOGIN(usuario, hash)
    alt 4a/4b. credenciales inválidas
      L -> DB : USUARIO_INCREMENTAR_INTENTOS\n(bloquea al 3.º)
      L -> DB : BITACORA: LOGIN_FALLIDO\n(+ USUARIO_BLOQUEADO\ny BLOQUEO en historial)
      L --> F : CredencialesInvalidas
      F -> I : Recalcular (si integridad válida)
      F --> U : mensaje de error
    else válidas
      L -> DB : USUARIO_RESETEAR_INTENTOS
      L -> DB : USUARIO_PERMISOS_LISTAR
      L -> S : setUsuario(u)\nsetPermisos(permisos)
      L -> DB : BITACORA: LOGIN
      L -> L : FachadaIdioma\n.AplicarPreferencia(u)
      L --> F : Exito
      alt integridad válida
        F -> I : RecalcularIntegridadUsuarios()
        I -> DB : DVH / DVV
        F --> U : "Bienvenido" + abre frmMenu
      else 9a. comprometida, admin íntegro
        F -> F : CU-02 «extend»
        F --> U : si se restauró: "Bienvenido"\n+ abre frmMenu
      else 9b. cualquier otro usuario
        F --> U : "El sistema no puede iniciarse..."
        F -> S : cerrarSesion()
      end
    end
  end
end

@enduml
