@startuml DiagramaSecuencia_CU06_CrearUsuario

title CU-06 — Crear usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 6
skinparam BoxPadding 4
skinparam maxMessageSize 115
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12
skinparam dpi 140
hide footbox

actor ":Administrador" as A
participant ":frmAdminUsuarios" as F #FEFECE
participant ":frmNuevoUsuario" as N #FEFECE
participant ":UsuarioBLL" as B #E8F4E8
participant ":IntegridadBLL" as I #E8F4E8
database ":DB" as DB #E8E8F4

A -> F : click "Nuevo"
F -> N : ShowDialog()
N -> DB : ROL_LISTAR_PARA_COMBO\n(PerfilBLL)
A -> N : datos + "Aceptar"
alt 4a. falta un dato obligatorio
  N --> A : "Ingresá un nombre\nde usuario." / ...
else 3a. cancela
  N --> F : Cancel
else
  N --> F : OK
  F -> B : Crear(usuario, contraseña,\nrolId, datos)
  B -> B : Hasher.Hashear()
  B -> DB : USUARIO_CREAR
  note right of DB : USUARIO + rol\nen USUARIO_PERFIL
  alt 6a. nombre existente
    B --> F : false
    F --> A : "El nombre de usuario\nya existe."
  else
    B -> I : RecalcularIntegridadUsuarios()
    B -> DB : HISTORIAL: ALTA
    B --> F : true
    F --> A : "Usuario creado\ncorrectamente."
  end
end

@enduml
