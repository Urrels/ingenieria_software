<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Misma base que la aplicación. Para probar sin tocar datos reales, cambiar Database. -->
        <add name="BDCAPAS"
             connectionString="Server=localhost\SQLEXPRESS01; Database=BDCAPAS; Trusted_Connection=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
