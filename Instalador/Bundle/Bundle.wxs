<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Gestión de gimnasio"
          Manufacturer="TP Ingeniería de Software"
          Version="1.0.7"
          UpgradeCode="07C59D9F-3B4F-40BA-931A-303F319BD1B9">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense"
                                              ThemeFile="Tema.xml"
                                              LicenseFile="..\Licencia.rtf"
                                              LocalizationFile="Tema.es-ES.wxl"
                                              ShowVersion="yes" />
    </BootstrapperApplication>

    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles6432Folder]Gestión de gimnasio" bal:Overridable="yes" />

    <Chain>
      <PackageGroupRef Id="NetFx48Web" />

      <MsiPackage Id="Aplicacion" SourceFile="$(var.Instalador.TargetPath)">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
