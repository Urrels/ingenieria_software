<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Gestión de gimnasio"
           Manufacturer="TP Ingeniería de Software"
           Version="1.0.5"
           UpgradeCode="AB5393F6-89D0-43A6-980E-68196A37FA92"
           Language="3082"
           Codepage="1252"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Ya hay instalada una versión más nueva de [ProductName]." />
    <MediaTemplate EmbedCab="yes" />

    <PropertyRef Id="WIXNETFX4RELEASEINSTALLED" />
    <Launch Condition="Installed OR WIXNETFX4RELEASEINSTALLED &gt;= &quot;#528040&quot;"
            Message="[ProductName] necesita .NET Framework 4.8. Instalalo desde https://dotnet.microsoft.com/download/dotnet-framework/net48 y volvé a ejecutar el instalador." />

    <Icon Id="IconoApp" SourceFile="$(var.AppBin)CAPAS.exe" />
    <Property Id="ARPPRODUCTICON" Value="IconoApp" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Gestión de gimnasio">
        <Directory Id="CarpetaScripts" Name="Scripts" />
        <?ifdef IncluirLocalDB ?>
        <Directory Id="CarpetaPrerequisitos" Name="Prerequisitos" />
        <?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CarpetaMenuInicio" Name="Gestión de gimnasio" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Principal" Title="Gestión de gimnasio" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.AppBin)**">
        <Exclude Files="$(var.AppBin)**\*.pdb" />
        <Exclude Files="$(var.AppBin)**\*.xml" />
        <Exclude Files="$(var.AppBin)**\*.log" />
      </Files>
      <Files Directory="CarpetaScripts" Include="$(var.Scripts)*.sql" />
      <!-- Datos de demostración serializados (JSON): los carga la aplicación para no mostrar el sistema vacío -->
      <Files Directory="CarpetaScripts" Include="$(var.Scripts)datos_demo.json" />
      <?ifdef IncluirLocalDB ?>
      <Files Directory="CarpetaPrerequisitos" Include="Prerequisitos\SqlLocalDB.msi" />
      <?endif?>
      <ComponentRef Id="AccesosDirectos" />
    </Feature>

    <Component Id="AccesosDirectos" Directory="CarpetaMenuInicio" Guid="C22F1BD3-4A60-4050-BC68-B3D056FFDD8A">
      <Shortcut Id="AccesoMenuInicio"
                Name="Gestión de gimnasio"
                Description="Sistema de gestión del gimnasio"
                Target="[INSTALLFOLDER]CAPAS.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="AccesoEscritorio"
                Directory="DesktopFolder"
                Name="Gestión de gimnasio"
                Description="Sistema de gestión del gimnasio"
                Target="[INSTALLFOLDER]CAPAS.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="AccesoEmulador"
                Name="Emulador de fichaje"
                Description="Simula el reloj de fichaje con tiempo acelerado y una API local para fichar"
                Target="[INSTALLFOLDER]EmuladorFichaje.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="AccesoConfigurador"
                Name="Configurar base de datos"
                Description="Crea la base de datos o cambia el servidor SQL Server"
                Target="[INSTALLFOLDER]ConfiguradorBD.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="QuitarCarpetaMenuInicio" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\GestionGimnasio" Name="Instalado" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Configurar la base de datos ahora" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Inmediata y con el usuario real (no SYSTEM): la autenticación de Windows usa su cuenta. /auto configura sin más clics. -->
    <CustomAction Id="AbrirConfigurador" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]ConfiguradorBD.exe&quot; /auto"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="AbrirConfigurador"
               Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="Licencia.rtf" />
  </Package>
</Wix>
